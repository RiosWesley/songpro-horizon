<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_activated="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hz_raised" />
            <stroke android:width="1dp" android:color="#997FD6FF" />
            <corners android:radius="@dimen/hz_radius_control" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/hz_raised" />
            <stroke android:width="1dp" android:color="@color/hz_hairline" />
            <corners android:radius="@dimen/hz_radius_control" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="@color/hz_hairline" />
            <corners android:radius="@dimen/hz_radius_control" />
        </shape>
    </item>
</selector>
