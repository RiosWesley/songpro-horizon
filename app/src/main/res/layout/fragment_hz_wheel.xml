<?xml version="1.0" encoding="utf-8"?>
<!-- Volante: the Horizon menu on a steering wheel key -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:theme="@style/ThemeOverlay.Horizon">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/hz_page_padding">

        <TextView
            style="@style/HzText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hz_wheel_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/hz_card_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/hz_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hz_card_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/hz_card_padding"
                android:paddingBottom="16dp">
        
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="24dp"
                    android:orientation="vertical">
        
                    <TextView
                        style="@style/HzText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hz_wheel_on" />
                    <TextView
                        style="@style/HzText.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hz_wheel_on_hint" />
                </LinearLayout>
        
                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/byd_wheel_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/hz_card_padding"
                android:layout_marginEnd="@dimen/hz_card_padding"
                android:background="@color/hz_hairline" />
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/hz_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hz_card_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/hz_card_padding"
                android:paddingBottom="16dp">
        
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="24dp"
                    android:orientation="vertical">
        
                    <TextView
                        style="@style/HzText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hz_wheel_key" />
                    <TextView
                        style="@style/HzText.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hz_wheel_key_hint" />
                </LinearLayout>
        
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
        
                    <TextView
                        android:id="@+id/byd_wheel_key"
                        style="@style/HzText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="16dp"
                        android:background="@drawable/hz_keycap_bg"
                        android:fontFamily="monospace"
                        android:paddingStart="10dp"
                        android:paddingTop="6dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="6dp"
                        android:textSize="16sp" />
        
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/byd_wheel_learn"
                        style="@style/HzButton.Secondary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hz_wheel_learn" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/hz_card_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/hz_card_padding">
        
                <TextView
                    style="@style/HzText.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/hz_wheel_open_title" />
        
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
        
                        <LinearLayout
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                        <TextView
                            style="@style/HzText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/hz_keycap_bg"
                            android:minWidth="40dp"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp"
                            android:layout_marginEnd="8dp"
                            android:text="&#9665;"
                            android:textSize="17sp" />
                        <TextView
                            style="@style/HzText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/hz_keycap_bg"
                            android:minWidth="40dp"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp"
                            android:layout_marginEnd="8dp"
                            android:text="&#9655;"
                            android:textSize="17sp" />
                        </LinearLayout>
        
                        <TextView
                            style="@style/HzText.Hint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hz_wheel_move" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
        
                        <LinearLayout
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                        <TextView
                            style="@style/HzText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/hz_keycap_bg"
                            android:minWidth="40dp"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/hz_key_roller"
                            android:textSize="17sp" />
                        </LinearLayout>
        
                        <TextView
                            style="@style/HzText.Hint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hz_wheel_change" />
                    </LinearLayout>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">
        
                        <LinearLayout
                            android:layout_width="160dp"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">
                        <TextView
                            style="@style/HzText"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:background="@drawable/hz_keycap_bg"
                            android:minWidth="40dp"
                            android:gravity="center"
                            android:paddingStart="10dp"
                            android:paddingTop="6dp"
                            android:paddingEnd="10dp"
                            android:paddingBottom="6dp"
                            android:layout_marginEnd="8dp"
                            android:text="@string/hz_key_menu"
                            android:textSize="17sp" />
                        </LinearLayout>
        
                        <TextView
                            style="@style/HzText.Hint"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/hz_wheel_close" />
                    </LinearLayout>
        
                <TextView
                    style="@style/HzText.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/hz_wheel_items" />
            </LinearLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/hz_wheel_log"
            style="@style/HzText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:visibility="gone" />

    </LinearLayout>
</ScrollView>
