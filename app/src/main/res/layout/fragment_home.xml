<?xml version="1.0" encoding="utf-8"?>
<!-- Início: what the car is waiting for and the one thing to do now on the left, the cluster as it
     looks with Horizon on the right. The old home (USB, self mode, Wi-Fi, exit) stays below, hidden:
     HomeFragment keeps its connection logic and these views drive it. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@style/ThemeOverlay.Horizon">

    <include
        layout="@layout/layout_home_legacy"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/hz_page_padding">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="42"
            android:orientation="vertical">

            <TextView
                android:id="@+id/hz_home_title"
                style="@style/HzText.Title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/hz_home_waiting" />

            <TextView
                android:id="@+id/hz_home_lead"
                style="@style/HzText.Lead"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hz_home_waiting_lead" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hz_home_primary"
                style="@style/HzButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="32dp"
                android:text="@string/hz_home_connect" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="vertical">

                <include
                    android:id="@+id/hz_status_aa"
                    layout="@layout/item_hz_status" />

                <include
                    android:id="@+id/hz_status_wheel"
                    layout="@layout/item_hz_status" />

                <include
                    android:id="@+id/hz_status_map"
                    layout="@layout/item_hz_status" />
            </LinearLayout>
        </LinearLayout>

        <Space
            android:layout_width="40dp"
            android:layout_height="match_parent" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="58"
            android:orientation="vertical">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/hz_home_cluster"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:adjustViewBounds="true"
                android:contentDescription="@string/hz_cluster_preview_description"
                android:scaleType="fitCenter"
                android:src="@drawable/hz_cluster_preview"
                app:shapeAppearance="@style/HzShape.Card"
                app:strokeColor="@color/hz_hairline"
                app:strokeWidth="1dp" />

            <TextView
                android:id="@+id/hz_home_cluster_caption"
                style="@style/HzText.Meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/hz_home_cluster_horizon" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
