<?xml version="1.0" encoding="utf-8"?>
<!-- One line of the car check: a status dot, what was checked and what was found. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="@dimen/hz_card_padding"
    android:paddingTop="16dp"
    android:paddingEnd="@dimen/hz_card_padding"
    android:paddingBottom="16dp">

    <ImageView
        android:id="@+id/onb_check_dot"
        android:layout_width="12dp"
        android:layout_height="12dp"
        android:layout_marginTop="7dp"
        android:importantForAccessibility="no"
        android:src="@drawable/hz_dot" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/onb_check_title"
            style="@style/HzText.Label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/onb_check_detail"
            style="@style/HzText.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</LinearLayout>
