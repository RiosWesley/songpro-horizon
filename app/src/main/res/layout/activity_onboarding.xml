<?xml version="1.0" encoding="utf-8"?>
<!-- First run: one step at a time in a centred column, the step count above, Back and Continue below.
     The container's side padding plus each step's own page padding make the same column. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/hz_page"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:theme="@style/ThemeOverlay.Horizon">

    <TextView
        android:id="@+id/onb_progress"
        style="@style/HzText.Meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/hz_onb_side"
        android:paddingTop="24dp"
        android:paddingEnd="@dimen/hz_onb_side" />

    <FrameLayout
        android:id="@+id/onb_container"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:paddingStart="@dimen/hz_onb_side_inner"
        android:paddingEnd="@dimen/hz_onb_side_inner" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/hz_hairline" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/hz_onb_side"
        android:paddingTop="16dp"
        android:paddingEnd="@dimen/hz_onb_side"
        android:paddingBottom="16dp">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onb_back"
            style="@style/HzButton.Secondary"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hz_onb_back" />

        <Space
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onb_next"
            style="@style/HzButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minWidth="200dp"
            android:text="@string/hz_onb_continue" />
    </LinearLayout>
</LinearLayout>
