<?xml version="1.0" encoding="utf-8"?>
<!-- Painel: the Horizon theme (install, restart the cluster, back to factory) and what Horizon shows -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:theme="@style/ThemeOverlay.Horizon">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/hz_page_padding">

        <TextView
            style="@style/HzText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hz_nav_cluster_title" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/hz_card_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/hz_card_padding">
        
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/hz_theme_picture"
                    android:layout_width="312dp"
                    android:layout_height="117dp"
                    android:contentDescription="@string/hz_cluster_preview_description"
                    android:scaleType="centerCrop"
                    android:src="@drawable/hz_cluster_preview"
                    app:shapeAppearance="@style/HzShape.Inner"
                    app:strokeColor="@color/hz_hairline"
                    app:strokeWidth="1dp" />
        
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="24dp"
                    android:layout_weight="1"
                    android:orientation="vertical">
        
                    <TextView
                        android:id="@+id/byd_theme_status"
                        style="@style/HzText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
        
                    <TextView
                        android:id="@+id/hz_theme_hint"
                        style="@style/HzText.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />
        
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:orientation="horizontal">
        
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/byd_theme_install"
                            style="@style/HzButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:text="@string/hz_theme_install" />
        
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/hz_theme_restart"
                            style="@style/HzButton.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:text="@string/hz_theme_restart" />
        
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/byd_theme_remove"
                            style="@style/HzButton.Secondary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/hz_theme_remove" />
                    </LinearLayout>
        
                    <TextView
                        android:id="@+id/byd_log"
                        style="@style/HzText.Meta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:maxLines="2"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/hz_card_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/hz_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hz_card_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/hz_card_padding"
                android:paddingBottom="16dp">
        
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="24dp"
                    android:orientation="vertical">
        
                    <TextView
                        style="@style/HzText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hz_skin_label" />
                    <TextView
                        style="@style/HzText.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hz_skin_hint" />
                </LinearLayout>
        
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/hz_skin_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </LinearLayout>
        
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/hz_card_padding"
                android:layout_marginEnd="@dimen/hz_card_padding"
                android:background="@color/hz_hairline" />
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/hz_card_padding"
                android:paddingTop="20dp"
                android:paddingEnd="@dimen/hz_card_padding"
                android:paddingBottom="24dp">
        
                <TextView
                    style="@style/HzText.Label"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/wheel_menu_power" />
        
                <TextView
                    style="@style/HzText.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/hz_power_hint" />
        
                <LinearLayout
                    android:id="@+id/hz_power_tiles"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal" />
            </LinearLayout>
        
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/hz_card_padding"
                android:layout_marginEnd="@dimen/hz_card_padding"
                android:background="@color/hz_hairline" />
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/hz_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hz_card_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/hz_card_padding"
                android:paddingBottom="16dp">
        
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="24dp"
                    android:orientation="vertical">
        
                    <TextView
                        style="@style/HzText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/wheel_menu_left_card" />
                </LinearLayout>
        
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/hz_card_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </LinearLayout>
        
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginStart="@dimen/hz_card_padding"
                android:layout_marginEnd="@dimen/hz_card_padding"
                android:background="@color/hz_hairline" />
        
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/hz_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hz_card_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/hz_card_padding"
                android:paddingBottom="16dp">
        
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="24dp"
                    android:orientation="vertical">
        
                    <TextView
                        style="@style/HzText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hz_map_label" />
                    <TextView
                        style="@style/HzText.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/byd_map_layout_hint" />
                </LinearLayout>
        
                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/hz_map_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
