<?xml version="1.0" encoding="utf-8"?>
<!-- Painel → Ajuste fino do mapa (MapTuneFragment): each map layout's picture and visible part, the
     map density, and the way back to the values measured on the car. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:theme="@style/ThemeOverlay.Horizon">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/hz_page_padding">

        <TextView
            style="@style/HzText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hz_tune_title" />

        <TextView
            style="@style/HzText.Lead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hz_tune_lead" />

        <TextView
            android:id="@+id/hz_tune_note"
            style="@style/HzText.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hz_tune_needs_horizon"
            android:textColor="@color/hz_warning"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/hz_card_bg"
            android:divider="@drawable/hz_divider"
            android:orientation="vertical"
            android:showDividers="middle">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/hz_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hz_card_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/hz_card_padding"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/HzText.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:layout_weight="1"
                    android:text="@string/hz_tune_layout" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/hz_tune_layout_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/hz_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hz_card_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/hz_card_padding"
                android:paddingBottom="16dp">

                <TextView
                    style="@style/HzText.Label"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="24dp"
                    android:layout_weight="1"
                    android:text="@string/hz_tune_step" />

                <com.google.android.material.button.MaterialButtonToggleGroup
                    android:id="@+id/hz_tune_step_group"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:selectionRequired="true"
                    app:singleSelection="true" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            style="@style/HzText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/hz_tune_picture" />

        <LinearLayout
            android:id="@+id/hz_tune_picture_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/hz_card_bg"
            android:divider="@drawable/hz_divider"
            android:orientation="vertical"
            android:showDividers="middle" />

        <TextView
            android:id="@+id/hz_tune_picture_hint"
            style="@style/HzText.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hz_tune_picture_hint" />

        <TextView
            style="@style/HzText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/hz_tune_visible" />

        <LinearLayout
            android:id="@+id/hz_tune_visible_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/hz_card_bg"
            android:divider="@drawable/hz_divider"
            android:orientation="vertical"
            android:showDividers="middle" />

        <TextView
            android:id="@+id/hz_tune_visible_size"
            style="@style/HzText.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp" />

        <TextView
            style="@style/HzText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:text="@string/hz_tune_density" />

        <LinearLayout
            android:id="@+id/hz_tune_density_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/hz_card_bg"
            android:divider="@drawable/hz_divider"
            android:orientation="vertical"
            android:showDividers="middle" />

        <TextView
            android:id="@+id/hz_tune_density_hint"
            style="@style/HzText.Hint"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hz_tune_density_hint" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hz_tune_reset"
                style="@style/HzButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/hz_tune_reset" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/hz_tune_reset_all"
                style="@style/HzButton.Secondary"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:text="@string/hz_tune_reset_all" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
