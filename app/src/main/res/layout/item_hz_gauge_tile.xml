<?xml version="1.0" encoding="utf-8"?>
<!-- One power gauge to choose on Painel: Horizon's own drawing of it and its name -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="152dp"
    android:layout_height="112dp"
    android:layout_marginEnd="12dp"
    android:background="@drawable/hz_tile_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:orientation="vertical">

    <ImageView
        android:id="@+id/hz_tile_picture"
        android:layout_width="64dp"
        android:layout_height="40dp"
        android:importantForAccessibility="no" />

    <TextView
        android:id="@+id/hz_tile_label"
        style="@style/HzText.Hint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:duplicateParentState="true"
        android:textColor="@color/hz_nav_text" />
</LinearLayout>
