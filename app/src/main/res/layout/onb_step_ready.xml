<?xml version="1.0" encoding="utf-8"?>
<!-- Onboarding, last step: where things are, and the panel restart when Horizon was installed. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/hz_page_padding">

        <TextView
            style="@style/HzText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hz_onb_ready_title" />

        <TextView
            android:id="@+id/onb_lead"
            style="@style/HzText.Lead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/hz_onb_ready_lead_later" />

        <LinearLayout
            android:id="@+id/onb_points"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/hz_card_bg"
            android:divider="@drawable/hz_divider"
            android:orientation="vertical"
            android:showDividers="middle" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/onb_restart"
            style="@style/HzButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/hz_onb_ready_restart"
            android:visibility="gone" />

        <TextView
            android:id="@+id/onb_log"
            style="@style/HzText.Meta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
