<?xml version="1.0" encoding="utf-8"?>
<!-- Sobre: what the app is, its credits, and the full settings inherited from open-headunit -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:theme="@style/ThemeOverlay.Horizon">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/hz_page_padding">

        <TextView
            style="@style/HzText.Title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/hz_nav_about" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/hz_card_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="@dimen/hz_card_padding">
        
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
        
                    <ImageView
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:importantForAccessibility="no"
                        android:src="@drawable/hz_horizon_mark" />
        
                    <TextView
                        style="@style/HzText.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="@string/app_name" />
        
                    <TextView
                        android:id="@+id/hz_about_version"
                        style="@style/HzText.Meta"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:fontFamily="monospace" />
                </LinearLayout>
        
                <TextView
                    style="@style/HzText.Lead"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/hz_about_what" />
        
                <TextView
                    style="@style/HzText.Hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:text="@string/hz_about_credits" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/hz_card_bg"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/hz_row_height"
                android:orientation="horizontal"
                android:paddingStart="@dimen/hz_card_padding"
                android:paddingTop="16dp"
                android:paddingEnd="@dimen/hz_card_padding"
                android:paddingBottom="16dp">
        
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="24dp"
                    android:orientation="vertical">
        
                    <TextView
                        style="@style/HzText.Label"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/hz_about_advanced" />
                    <TextView
                        style="@style/HzText.Hint"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hz_about_advanced_hint" />
                </LinearLayout>
        
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/hz_about_open_advanced"
                    style="@style/HzButton.Secondary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hz_about_open" />
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>
</ScrollView>
